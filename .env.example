# 브라우저에 공개되는 Firebase Web 설정입니다. 비밀 키를 넣지 마세요.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-firebase-web-app-id
FIREBASE_DATABASE_URL=https://trick-or-treat-89de3-default-rtdb.asia-southeast1.firebasedatabase.app
# 운영자 계정의 Firebase UID를 쉼표로 구분합니다. 닉네임을 넣지 마세요.
GAME_ADMIN_UIDS=

# 서버 전용 비밀값입니다. Firebase 서비스 계정 JSON 전체를 한 줄로 넣습니다.
# 로컬 개발에서는 사용하지 않습니다. Vercel 환경 변수에만 설정하세요.
FIREBASE_SERVICE_ACCOUNT_JSON=
