rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function activePlayer() {
      return request.auth != null && !exists(/databases/$(database)/documents/gameBans/$(request.auth.uid));
    }
    match /gamePlayers/{uid} {
      allow read: if activePlayer();
      allow write: if false;
    }
    match /game/event {
      allow read: if activePlayer();
      allow write: if false;
    }
    match /villages/{village} {
      allow read: if activePlayer();
      allow write: if false;
    }
    match /gameRounds/{round} {
      allow read: if activePlayer();
      allow write: if false;
    }
    match /profiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /privateAccounts/{uid} {
      allow read, write: if false;
    }

    match /nicknameClaims/{nicknameKey} {
      allow read, write: if false;
    }

    match /authRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
