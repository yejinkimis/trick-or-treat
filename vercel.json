{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "regions": [
    "icn1"
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false,
      "**": false
    }
  },
  "redirects": [
    {
      "source": "/prototype/trick-or-treat.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "functions": {
    "api/game/wrap.js": {
      "includeFiles": "wrap/**"
    }
  }
}
