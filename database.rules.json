{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$village": {
        ".read": "auth != null && root.child('bannedUsers').child(auth.uid).val() !== true",
        "$uid": {
          "$session": {
            ".write": "auth != null && root.child('bannedUsers').child(auth.uid).val() !== true && auth.uid == $uid && $village.matches(/^[1-9][0-9]{0,3}$/)",
            ".validate": "newData.hasChildren(['x','y','f','m','at'])",
            "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 416" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000" },
            "f": { ".validate": "newData.val() == 1 || newData.val() == -1" },
            "m": { ".validate": "newData.isBoolean()" },
            "at": { ".validate": "newData.isNumber() && newData.val() >= now - 5000 && newData.val() <= now + 1000" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "online": {
      ".read": "auth != null && root.child('bannedUsers').child(auth.uid).val() !== true",
      "$uid": {
        "$session": {
          ".write": "auth != null && root.child('bannedUsers').child(auth.uid).val() !== true && auth.uid == $uid",
          ".validate": "newData.hasChildren(['v','at'])",
          "v": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9999" },
          "at": { ".validate": "newData.isNumber() && newData.val() >= now - 5000 && newData.val() <= now + 1000" },
          "$other": { ".validate": false }
        }
      }
    },
    "chat": {
      ".read": "auth != null && root.child('bannedUsers').child(auth.uid).val() !== true",
      "$uid": {
        ".write": "auth != null && root.child('bannedUsers').child(auth.uid).val() !== true && auth.uid == $uid && newData.exists() && (!data.exists() || now - data.child('at').val() >= 600)",
        ".validate": "newData.hasChildren(['id','kind','text','v','at'])",
        "id": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "kind": { ".validate": "newData.val() == 'chat'" },
        "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "v": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9999" },
        "at": { ".validate": "newData.isNumber() && newData.val() >= now - 5000 && newData.val() <= now + 1000" },
        "$other": { ".validate": false }
      }
    },
    "chatLog": {
      ".read": "auth != null && root.child('bannedUsers').child(auth.uid).val() !== true",
      "$id": {
        ".write": "auth != null && root.child('bannedUsers').child(auth.uid).val() !== true && !data.exists() && newData.exists() && root.child('chat').child(auth.uid).child('id').val() != $id && newData.parent().parent().child('chat').child(auth.uid).child('id').val() == $id",
        ".validate": "newData.hasChildren(['id','by','text','v','at'])",
        "id": { ".validate": "newData.val() == $id" },
        "by": { ".validate": "newData.val() == auth.uid" },
        "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "v": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9999" },
        "at": { ".validate": "newData.isNumber() && newData.val() >= now - 5000 && newData.val() <= now + 1000" },
        "$other": { ".validate": false }
      }
    },
    "announcements": {
      ".read": "auth != null && root.child('bannedUsers').child(auth.uid).val() !== true",
      "current": {
        ".write": false
      }
    },
    "events": {
      "$village": {
        ".read": "auth != null && root.child('bannedUsers').child(auth.uid).val() !== true",
        "$uid": {
          ".write": "auth != null && root.child('bannedUsers').child(auth.uid).val() !== true && auth.uid == $uid && $village.matches(/^[1-9][0-9]{0,3}$/) && newData.exists() && (!data.exists() || now - data.child('at').val() >= 600)",
          ".validate": "newData.hasChildren(['id','kind','to','at'])",
          "id": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "kind": { ".validate": "newData.val() == 'bonk'" },
          "to": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "at": { ".validate": "newData.isNumber() && newData.val() >= now - 5000 && newData.val() <= now + 1000" },
          "$other": { ".validate": false }
        }
      }
    },
    "bannedUsers": {
      "$uid": { ".read": "auth != null && auth.uid == $uid" }
    }
  }
}
